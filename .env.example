# Copy this file to .env.local for local development.
# On Vercel, set these as Environment Variables in Project Settings instead.

# Your Neon connection string — Neon dashboard → Connection Details → "Pooled connection"
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require

# Any long random string — generate with: openssl rand -base64 32
AUTH_SECRET=
